#include <windows.h>
#include "aegra_version.h"

#ifndef AEGRI_FILE_DESCRIPTION
#define AEGRI_FILE_DESCRIPTION AEGRI_PRODUCT_NAME
#endif
#ifndef AEGRI_INTERNAL_NAME
#define AEGRI_INTERNAL_NAME AEGRI_PRODUCT_NAME
#endif
#ifndef AEGRI_ORIGINAL_FILENAME
#define AEGRI_ORIGINAL_FILENAME ""
#endif
#ifndef AEGRI_FILETYPE
#define AEGRI_FILETYPE VFT_APP
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION AEGRI_VERSION_COMMA
 PRODUCTVERSION AEGRI_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE AEGRI_FILETYPE
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      AEGRI_COMPANY_NAME
            VALUE "FileDescription",  AEGRI_FILE_DESCRIPTION
            VALUE "FileVersion",      AEGRI_VERSION_STRING
            VALUE "InternalName",     AEGRI_INTERNAL_NAME
            VALUE "LegalCopyright",   AEGRI_COPYRIGHT
            VALUE "LegalTrademarks",  AEGRI_LEGAL_TRADEMARKS
            VALUE "OriginalFilename", AEGRI_ORIGINAL_FILENAME
            VALUE "ProductName",      AEGRI_PRODUCT_NAME
            VALUE "ProductVersion",   AEGRI_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
