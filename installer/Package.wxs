<?xml version="1.0" encoding="UTF-8"?>
<!--
  Aegra Image MSI package (WiX v4/v7 schema).
  Built by installer/build.ps1 → out\AegraImage.msi
  Service: aegra_service.exe as Windows service AegraService (SCM flag service).
  Recovery: restart on first/second/subsequent failure, 0-day reset, 0-minute delay.
  Data: %ProgramData%\Aegra (matches Service runtime, not brand path AegraImage).
  Kernel Dokan is the official Dokan_x64.msi chained in the Bundle.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package
      Name="AegraImage"
      Manufacturer="Aegra"
      Version="$(var.ProductVersion)"
      UpgradeCode="5C2A9E71-8B4F-4D16-9E3A-7F1C0B6D2A84"
      Scope="perMachine"
      Language="1033"
      InstallerVersion="500">

    <SummaryInformation
        Description="Aegra Image — backup, restore, mount and shell extension"
        Manufacturer="Aegra" />

    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of AegraImage is already installed. Setup will now exit."
        Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="MSIUSEREALADMINDETECTION" Value="1" />
    <Property Id="DELETEDATA" Secure="yes" />
    <Launch Condition="Privileged" Message="AegraImage requires administrator privileges to install." />

    <Feature Id="ProductFeature" Title="AegraImage" Level="1"
             Description="Desktop, CLI, service, worker, WinPE executor, shell extension and runtime."
             ConfigurableDirectory="INSTALLFOLDER"
             AllowAdvertise="no"
             Display="expand">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="cmpServerService" />
      <ComponentRef Id="cmpStartMenuShortcuts" />
      <ComponentRef Id="cmpDesktopShortcut" />
      <ComponentRef Id="cmpRegistryApp" />
      <ComponentRef Id="cmpProgramDataAegra" />
    </Feature>

    <!--
      Shell registration is owned entirely by DllRegisterServer (regsvr32): the .rgs
      scripts in the DLL write the .bkf association, ProgId, CLSID and Approved rows,
      and broadcast SHCNE_ASSOCCHANGED so Explorer refreshes immediately. The MSI
      authors no Classes rows itself; CA_UnregisterShell reverses everything at
      uninstall before the files are removed.

      For a deferred EXE custom action, ExeCommand is formatted while MSI builds the
      execution script. Do not indirect it through [CustomActionData]: the Type 34
      target then formats to an empty command and MSI reports error 1721. Always use
      the full path to regsvr32 — Type 34 does not search PATH. Registration is vital
      (Return="check") so setup cannot silently succeed with an unusable extension.
    -->
    <!--
      Impersonate="yes": run regsvr32 with the installing user's (elevated) token in
      the user's session, not LocalSystem. The install already requires elevation, so
      HKLM\Software\Classes writes still succeed, and the SHCNE_ASSOCCHANGED broadcast
      from DllRegisterServer reaches the logged-on user's Explorer (a session-0 SYSTEM
      broadcast does not), so icons and the .bkf association refresh immediately.
    -->
    <CustomAction Id="CA_RegisterShell"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /s &quot;[INSTALLFOLDER]aegra_shell_extension.dll&quot;"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="check" />

    <CustomAction Id="CA_UnregisterShell"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /s /u &quot;[INSTALLFOLDER]aegra_shell_extension.dll&quot;"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <CustomAction Id="CA_DeleteProgramData"
                  Directory="System64Folder"
                  ExeCommand="cmd.exe /c if exist &quot;[CommonAppDataFolder]Aegra&quot; rmdir /s /q &quot;[CommonAppDataFolder]Aegra&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="CA_UnregisterShell" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />

      <Custom Action="CA_DeleteProgramData" After="RemoveFiles"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND (DELETEDATA=&quot;1&quot; OR DELETEDATA=&quot;true&quot; OR DELETEDATA=&quot;True&quot;)" />

      <!--
        Last deferred op before the script commits: files, registry, service and
        shortcuts are all in place when regsvr32 registers and broadcasts
        SHCNE_ASSOCCHANGED, and nothing that could still fail runs after it
        (regsvr32 has no rollback action).
      -->
      <Custom Action="CA_RegisterShell" Before="InstallFinalize" Condition="NOT REMOVE" />
    </InstallExecuteSequence>

    <UI>
      <Dialog Id="DeleteDataDlg" Width="370" Height="250" Title="Uninstall AegraImage">
        <Control Id="Title" Type="Text" X="15" Y="12" Width="340" Height="20" Transparent="yes" NoPrefix="yes"
                 Text="Uninstall AegraImage" />
        <Control Id="Description" Type="Text" X="15" Y="40" Width="340" Height="50" Transparent="yes" NoPrefix="yes"
                 Text="This will remove Aegra Image from your computer. Program files will be deleted." />
        <Control Id="DataNote" Type="Text" X="15" Y="95" Width="340" Height="30" Transparent="yes" NoPrefix="yes"
                 Text="Runtime data (database, logs, PE cache) is stored under ProgramData\Aegra and is kept by default." />
        <Control Id="DeleteDataCheck" Type="CheckBox" X="15" Y="135" Width="340" Height="30"
                 Property="DELETEDATA" CheckBoxValue="1"
                 Text="Also delete application data (ProgramData\Aegra)" />
        <Control Id="Back" Type="PushButton" X="180" Y="220" Width="56" Height="17" Disabled="yes" Text="Back" />
        <Control Id="Uninstall" Type="PushButton" X="236" Y="220" Width="66" Height="17" Default="yes" Text="Uninstall">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="306" Y="220" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <InstallUISequence>
        <Show Dialog="DeleteDataDlg" Before="ExecuteAction"
              Condition="Installed AND REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND UILevel &gt; 2" />
      </InstallUISequence>
    </UI>

  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AegraImage" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="AegraImage" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.Payload)\**">
        <Exclude Files="!(bindpath.Payload)\aegra_service.exe" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Component Id="cmpServerService" Directory="INSTALLFOLDER" Guid="A18F3C20-6D4B-4E91-9C7A-2E5B8F0D1A63">
      <File Id="filAegraService"
            Source="!(bindpath.Payload)\aegra_service.exe"
            KeyPath="yes" />

      <ServiceInstall Id="svcAegraService"
                      Name="AegraService"
                      DisplayName="Aegra Management Service"
                      Description="Aegra Image control-plane service"
                      Type="ownProcess"
                      Start="auto"
                      Account="LocalSystem"
                      ErrorControl="normal"
                      Arguments="--service"
                      Vital="yes">
        <!-- SCM Recovery: restart immediately on first/second/subsequent crash. -->
        <util:ServiceConfig
            FirstFailureActionType="restart"
            SecondFailureActionType="restart"
            ThirdFailureActionType="restart"
            ResetPeriodInDays="0"
            RestartServiceDelayInSeconds="0" />
      </ServiceInstall>

      <ServiceControl Id="scAegraService"
                      Name="AegraService"
                      Start="install"
                      Stop="both"
                      Remove="uninstall"
                      Wait="no" />
    </Component>
  </Fragment>

  <Fragment>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="ProgramDataAegraFolder" Name="Aegra">
        <Directory Id="ProgramDataLogsFolder" Name="logs" />
        <Directory Id="ProgramDataPeFolder" Name="pe" />
      </Directory>
    </StandardDirectory>
    <Component Id="cmpProgramDataAegra" Directory="ProgramDataAegraFolder" Guid="07E39286-C1AF-4457-D2D0-8EB14D6370C9">
      <RegistryValue Root="HKLM"
                     Key="Software\AegraImage"
                     Name="ProgramDataFolder"
                     Type="string"
                     Value="[ProgramDataAegraFolder]"
                     KeyPath="yes" />
      <CreateFolder />
    </Component>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="cmpStartMenuShortcuts" Guid="B29E4D31-7C5A-4F02-8D8B-3F6C9E1E2B74">
        <Shortcut Id="scGui"
                  Name="Aegra Image"
                  Description="Aegra Image"
                  Target="[INSTALLFOLDER]aegra_desktop.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="scUninstall"
                  Name="Uninstall Aegra Image"
                  Description="Remove Aegra Image"
                  Target="[System64Folder]msiexec.exe"
                  Arguments="/x [ProductCode]" />
        <RemoveFolder Id="RemoveAppProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\AegraImage"
                       Name="StartMenuInstalled"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="cmpDesktopShortcut" Guid="C3AF5E42-8D6B-4013-9E9C-4A7D0F2F3C85">
        <Shortcut Id="scDesktopGui"
                  Name="Aegra Image"
                  Description="Aegra Image"
                  Target="[INSTALLFOLDER]aegra_desktop.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\AegraImage"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <Component Id="cmpRegistryApp" Directory="INSTALLFOLDER" Guid="D4B06F53-9E7C-4124-AFAD-5B8E1A304D96">
      <RegistryKey Root="HKLM" Key="Software\AegraImage">
        <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RegistryValue Name="Version" Type="string" Value="$(var.ProductVersion)" />
      </RegistryKey>
      <RegistryKey Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\aegra_service.exe">
        <RegistryValue Type="string" Value="[INSTALLFOLDER]aegra_service.exe" />
        <RegistryValue Name="Path" Type="string" Value="[INSTALLFOLDER]" />
      </RegistryKey>
      <RegistryKey Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\aegra_cli.exe">
        <RegistryValue Type="string" Value="[INSTALLFOLDER]aegra_cli.exe" />
        <RegistryValue Name="Path" Type="string" Value="[INSTALLFOLDER]" />
      </RegistryKey>
    </Component>

  </Fragment>

</Wix>
