<?xml version="1.0" encoding="utf-8"?>
<WixLocalization Culture="ja-JP" Language="1041" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="Caption" Value="[WixBundleName] セットアップ" />
  <String Id="Title" Value="[WixBundleName]" />
  <String Id="CheckingForUpdatesLabel" Value="更新を確認しています" />
  <String Id="UpdateButton" Value="バージョン [WixStdBAUpdateAvailable] に更新(&amp;U)" />
  <String Id="InstallHeader" Value="ようこそ" />
  <String Id="InstallMessage" Value="セットアップは [WixBundleName] をこのコンピューターにインストールします。[インストール] をクリックして続行するか、[キャンセル] で終了します。" />
  <String Id="InstallMessageOptions" Value="セットアップは [WixBundleName] をこのコンピューターにインストールします。[インストール]、[オプション]、または [キャンセル] を選択してください。" />
